    "worker": "tsx scripts/worker.ts",
    "replay": "tsx scripts/replay.ts",
    "build:worker": "node scripts/build-worker.mjs",
    "deploy": "node scripts/deploy.mjs",
    "bootstrap": "tsx scripts/bootstrap.ts"
