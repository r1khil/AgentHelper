# Supabase (Project settings → API / Database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Postgres connection string (transaction pooler, port 6543)
DATABASE_URL=

# App
APP_URL=http://localhost:3000
CRON_SECRET=
SEED_ADMIN_PASSWORD=

# Google sign-in (Google Cloud → APIs & Services → Credentials, OAuth client).
# With both set, the OAuth redirect stays on APP_URL so Google's consent screen
# names this app instead of <ref>.supabase.co. Register
# <APP_URL>/auth/google/callback as an authorized redirect URI on the client.
# Leave blank to fall back to Supabase's hosted flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Agent (OpenRouter)
OPENROUTER_API_KEY=
# Fallback only: admins pick the model on the Admin page, which overrides this.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free
# Optional: a cheaper model for per-document summaries of Drive files (defaults to OPENROUTER_MODEL).
# Each file version is summarized once; a Sonnet-class model costs a few cents per document.
OPENROUTER_SUMMARY_MODEL=
# Retrieval (search over Drive documents and indexed SEC filings). Fallbacks only: admins pick both models on the
# Admin page (Retrieval card), which overrides these. Ids must be in EMBEDDING_MODELS / RERANK_MODELS
# (src/lib/agent/retrieval-models.ts); the chunk table accepts any vector length, so switching needs no migration.
# Set OPENROUTER_EMBEDDINGS=off to skip embeddings (full-text search still works).
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# Documents embedded per ingest run (default 15). Each run stays within one serverless function's time budget.
DRIVE_INGEST_MAX_FILES=

# Web search and page reading for the agent (search_web, read_url) via Tavily. Optional; without it read_url falls
# back to a bounded direct fetch and search_web is unavailable. Free plan: 1,000 credits/month.
TAVILY_API_KEY=

# Data providers
EDGAR_USER_AGENT="Owl Fund Workspace contact@example.com"
FINNHUB_API_KEY=
RESEND_API_KEY=
EMAIL_FROM="The Owl's Nest <onboarding@resend.dev>"
# Outgoing mail through a Gmail account instead of Resend (used whenever both are set). Resend's
# onboarding@resend.dev sender only reaches the Resend account owner, and the fund has no verified
# domain. GMAIL_APP_PASSWORD is a 16-character app password (needs 2-Step Verification on the account).
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME="The Owl's Nest"

# Weekly update pack (/weekly): the execs answer the Sunday process-update ask by replying to email.
# INBOUND_EMAIL_DOMAIN is the Resend receiving domain, e.g. the account's free <id>.resend.app; the
# reply-to address is weekly+<week ending>-<token>@<that domain>. RESEND_API_KEY is still needed to
# read the replies. RESEND_WEBHOOK_SECRET signs the email.received webhook pointed at
# <APP_URL>/api/email/inbound.
# Without these the ask is recorded as skipped instead of sent. See docs/weekly-update.md.
INBOUND_EMAIL_DOMAIN=
RESEND_WEBHOOK_SECRET=

# Google Drive (admin connects their account from /admin; see README "Google Drive")
# The existing Google OAuth client; add ${APP_URL}/api/google/callback to its redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Encrypts the stored refresh token at rest: openssl rand -base64 32
DRIVE_TOKEN_KEY=

# Economic Calendar: Trading Economics preferred, EODHD fallback. Server-only.
TRADING_ECONOMICS_API_KEY=
EODHD_API_KEY=
# Required only for EODHD: set the timezone confirmed by your provider (IANA zone or UTC).
EODHD_CALENDAR_TIMEZONE=

# auto uses configured paid APIs, or biquote when no API keys are set.
# biquote explicitly selects the free feed; public selects legacy agency feeds.
ECONOMIC_CALENDAR_PROVIDER=auto

# Changelog page (execs and admins): merged pull requests summarized in plain English.
# Fine-grained personal access token with read-only "Pull requests" access to the repo below.
GITHUB_TOKEN=
GITHUB_REPO=r1khil/AgentHelper
# Free OpenRouter model that writes the summaries (default cohere/north-mini-code:free; "agent" uses the Admin page choice).
CHANGELOG_MODEL=

# Optional contact for the legacy public agency provider.
# BLS blocks User-Agents that include a URL and asks for contact details; sent as OwlFundCalendar/1.0 (<email>).
CALENDAR_CONTACT_EMAIL=

# Sell-side call transcription runs through the existing OpenRouter key
# (qwen/qwen3-asr-0.6b speech-to-text; timestamps, no speaker labels).
# No separate transcription key is needed.
