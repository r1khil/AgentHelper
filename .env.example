# Supabase (Project settings → API / Database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Postgres connection string (transaction pooler, port 6543)
DATABASE_URL=

# App
APP_URL=http://localhost:3000
CRON_SECRET=
SEED_ADMIN_PASSWORD=

# Google sign-in (Google Cloud → APIs & Services → Credentials, OAuth client).
# With both set, the OAuth redirect stays on APP_URL so Google's consent screen
# names this app instead of <ref>.supabase.co. Register
# <APP_URL>/auth/google/callback as an authorized redirect URI on the client.
# Leave blank to fall back to Supabase's hosted flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Agent (OpenRouter)
OPENROUTER_API_KEY=
# Fallback only: admins pick the model on the Admin page, which overrides this.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free

# Data providers
EDGAR_USER_AGENT="Owl Fund Workspace contact@example.com"
FINNHUB_API_KEY=
RESEND_API_KEY=
EMAIL_FROM="Owl Fund Workspace <onboarding@resend.dev>"

# Google Drive (admin connects their account from /admin; see README "Google Drive")
# The existing Google OAuth client; add ${APP_URL}/api/google/callback to its redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Encrypts the stored refresh token at rest: openssl rand -base64 32
DRIVE_TOKEN_KEY=
